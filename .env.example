# Copie para .env e ajuste. .env nunca vai para o repositório.

DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-isto-em-producao

# Chaves antigas durante rotação de SECRET_KEY, separadas por vírgula.
# Permite trocar a chave sem deslogar todo mundo — sessão vive em cookie
# assinado (§3.5), então trocar a chave sem fallback invalida todas.
SECRET_KEY_FALLBACKS=

DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://buddhadharma:dev-only-nao-use-em-producao@127.0.0.1:5432/buddhadharma
POSTGRES_PASSWORD=dev-only-nao-use-em-producao

REDIS_URL=redis://127.0.0.1:6379/0

# CSP em modo de relato: o navegador denuncia as violações e não bloqueia
# nada. Serve para validar a política contra tráfego real antes de aplicá-la.
# Vazio ou 0 aplica a política — que é o padrão (§7.1).
CSP_REPORT_ONLY=0

# SMTP. Sem isto a recuperação de senha (§7.3) falha em silêncio: a página diz
# que o link foi enviado e nenhum email sai. Em desenvolvimento não é preciso
# preencher — config/settings/dev.py imprime a mensagem no terminal.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
# Precisa ser um endereço do próprio domínio, ou a mensagem cai em spam por
# falha de SPF/DKIM.
DEFAULT_FROM_EMAIL=Buddhadharma <nao-responda@exemplo.org>
