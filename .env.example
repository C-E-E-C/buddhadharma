# Copie para .env e ajuste. .env nunca vai para o repositório.

DJANGO_SETTINGS_MODULE=config.settings.dev

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=troque-isto-em-producao

# Chaves antigas durante rotação de SECRET_KEY, separadas por vírgula.
# Permite trocar a chave sem deslogar todo mundo — sessão vive em cookie
# assinado (§3.5), então trocar a chave sem fallback invalida todas.
SECRET_KEY_FALLBACKS=

DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

DATABASE_URL=postgres://buddhadharma:dev-only-nao-use-em-producao@127.0.0.1:5432/buddhadharma
POSTGRES_PASSWORD=dev-only-nao-use-em-producao

REDIS_URL=redis://127.0.0.1:6379/0
